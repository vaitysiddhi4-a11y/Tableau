      <aliases enabled='yes' />
      <column caption='Review performance score' datatype='integer' name='[Calculation_1102585177141248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Price category' datatype='string' name='[Calculation_1102585178607618]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;=300 THEN &quot; Luxury&quot; ELSEIF [Price]&gt;150 THEN &quot;Standard&quot; ELSE &quot;budget&quot; END' />
      </column>
      <column caption='host status' datatype='string' name='[Calculation_1121002330300416]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since]&lt;=TODAY()THEN &quot;active host&quot;&#13;&#10;ELSE &quot;new host&quot;&#13;&#10;END' />
      </column>
      <column caption='Hotel' datatype='string' name='[Calculation_1121002330902529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;=100 THEN &quot;highly reviewed&quot;&#13;&#10;ELSE &quot;less reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_1121002335477764]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;[Parameters].[Parameter 1121002334371842]&#13;&#10;THEN &quot;Above limit&quot;&#13;&#10;ELSE &quot;Below limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Bed Criteria' datatype='string' name='[Calculation_1121002338594822]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Beds]&gt;[Parameters].[Parameter 1121002338226181]&#13;&#10;THEN &quot;optimum number of beds&quot;&#13;&#10;ELSE &quot;Not Enough beds&quot;&#13;&#10;END' />
      </column>
      <column caption='Hotel counts' datatype='integer' name='[Calculation_1121002341732360]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Name])' />
      </column>
      <column caption='Host Since_New' datatype='date' name='[Calculation_1121002343559177]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Property type_New' datatype='string' name='[Calculation_1121002345398282]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Property Type],&quot;unknown&quot;)' />
      </column>
      <column datatype='integer' name='[Host Id]' role='dimension' type='ordinal' />
      <column datatype='date' hidden='true' name='[Host Since]' role='dimension' type='ordinal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
